# Valores reproducibles para desarrollo local con Docker Compose.
# Un archivo .env opcional puede sobrescribirlos sin versionar secretos reales.
DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret
WEBHOOK_SECRET=replace-with-an-independent-webhook-secret
WEBHOOK_TOLERANCE_SECONDS=300
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173
TRUST_X_FORWARDED_PROTO=False
USE_X_FORWARDED_HOST=False
DATABASE_URL=mysql://archivault:YOUR_DB_PASSWORD@db:3306/archivault

# Multimedia: "filesystem" (predeterminado) o "s3".
MEDIA_STORAGE_BACKEND=filesystem
# Obligatorios únicamente cuando MEDIA_STORAGE_BACKEND=s3.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
# Vigencia, en segundos, de las URLs privadas firmadas.
AWS_S3_QUERYSTRING_EXPIRE=900

MYSQL_PASSWORD=YOUR_DB_PASSWORD
MYSQL_ROOT_PASSWORD=YOUR_ROOT_PASSWORD
CORS_ALLOWED_ORIGINS=http://localhost:5173
